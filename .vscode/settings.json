{
	"eslint.workingDirectories": [{ "pattern": "src/*/" }],
	"tailwindCSS.classFunctions": ["cva", "cn"],
	"files.exclude": {
		"deprecated": true
	},
	"files.readonlyInclude": {
		"**/route-tree.gen.ts": true,
		"pnpm-lock.yaml": true
	},
	"files.watcherExclude": {
		"**/route-tree.gen.ts": true,
		"pnpm-lock.yaml": true
	},
	"search.exclude": {
		"**/route-tree.gen.ts": true,
		"pnpm-lock.yaml": true
	},
	"material-icon-theme.folders.associations": {
		"(features)": "Plugin",
		"(auth)": "Secure",
		"(public)": "Public",
		"-api": "Api",
		"-components": "React-Components",
		"-constants": "Constant",
		"-contexts": "Context",
		"-errors": "Error",
		"-guard": "Guard",
		"-types": "Typescript",
		"-hooks": "Hook",
		"-partials": "Include",
		"-schemas": "Class",
		"-shared": "Shared",
		"-utils": "Utils",
		"-helpers": "Helper",
		"-mocks": "Mock",
		"-configs": "Config",
		"-workers": "Taskfile"
	},
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"editor.tabSize": 3,
	"[yaml]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},
	"js/ts.experimental.useTsgo": false
}
