{
	"useTabs": true,
	"tabWidth": 3,
	"trailingComma": "none",
	"endOfLine": "auto",
	"singleQuote": true,
	"printWidth": 120,
	"jsxSingleQuote": true,
	"bracketSameLine": true,
	"bracketSpacing": true,
	"arrowParens": "always",
	"semi": false,
	"plugins": [
		"prettier-plugin-tailwindcss",
		"prettier-plugin-organize-imports",
		"prettier-plugin-tailwindcss-canonical-classes"
	],
	"tailwindStylesheet": "./src/styles/index.css",
	"tailwindcssCanonicalStylesheet": "./src/styles/index.css"
}
